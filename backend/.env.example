# Copy to backend/.env for local development. Never commit .env.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lsd_cdss

# HS256 signing key for access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# AES-256 key for the genetics field, 32 bytes base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored genetics unreadable.
GENETICS_ENC_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT=20

# Dev seed only: password for every seeded account (admin@, doctor@, lab@, patient@lsd.test).
SEED_PASSWORD=

SESSION_RATE_LIMIT=240
